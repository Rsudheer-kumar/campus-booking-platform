# ============================================================
# CampusFlow API - Environment Configuration Example
# Copy this file to .env and configure for your local environment
# ============================================================

# Runtime Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/campusflow

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# Allowed CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# Phase 3.3: Check-In & Auto-Release Configuration
# ------------------------------------------------------------

# Early check-in window in minutes prior to reservation startAt (1-60, default 15)
CHECKIN_EARLY_MINUTES=15

# Post-start grace period in minutes before auto-release triggers (5-60, default 15)
AUTO_RELEASE_GRACE_MINUTES=15

# Rolling window in days for evaluating unexcused no-shows (7-90, default 30)
NO_SHOW_WINDOW_DAYS=30

# Number of unexcused no-shows required to trigger temporary suspension (1-10, default 3)
NO_SHOW_STRIKE_THRESHOLD=3

# Duration in days of booking suspension after reaching strike threshold (1-60, default 14)
NO_SHOW_SUSPENSION_DAYS=14

# Autonomous background scheduler poll interval in milliseconds (10000-300000, default 60000)
AUTO_RELEASE_POLL_INTERVAL_MS=60000

# Maximum lookback window in hours for abandoned reservations (1-168, default 24)
AUTO_RELEASE_LOOKBACK_HOURS=24
